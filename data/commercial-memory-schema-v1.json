{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommercialOpportunityMemory",
  "type": "object",
  "required": ["id", "contact", "company", "stage", "summary", "next_action"],
  "properties": {
    "id": {"type":"string"},
    "contact": {"type":"object","properties":{"name":{"type":"string"},"role":{"type":["string","null"]},"email":{"type":["string","null"]},"phone":{"type":["string","null"]}},"required":["name"]},
    "company": {"type":"object","properties":{"name":{"type":"string"},"website":{"type":["string","null"]},"country":{"type":["string","null"]}},"required":["name"]},
    "stage": {"type":"string"},
    "summary": {"type":"string"},
    "need": {"type":["string","null"]},
    "goal": {"type":["string","null"]},
    "objections": {"type":"array","items":{"type":"string"}},
    "last_intent": {"type":["string","null"]},
    "lead_score": {"type":"number"},
    "owner_id": {"type":["string","null"]},
    "next_action": {"type":"string"},
    "next_follow_up_at": {"type":["string","null"],"format":"date-time"},
    "human_required": {"type":"boolean"},
    "human_reason": {"type":["string","null"]},
    "memory_facts": {"type":"array","items":{"type":"object","required":["fact","source_event_id","confidence"],"properties":{"fact":{"type":"string"},"source_event_id":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"created_at":{"type":"string","format":"date-time"},"last_confirmed_at":{"type":["string","null"],"format":"date-time"}}}}
  }
}
